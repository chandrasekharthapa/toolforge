# --- pick one model provider -------------------------------------------------
TOOLFORGE_PROVIDER=gemini            # gemini | anthropic | groq | nvidia | cerebras | ollama | openrouter | openai
# TOOLFORGE_MODEL=gemini-2.5-flash   # optional override of the provider's default model
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=                   # build.nvidia.com (free tier)
# CEREBRAS_API_KEY=
# OPENAI_API_KEY=
# TOOLFORGE_BASE_URL=                # for self-hosted OpenAI-compatible servers

# --- embeddings for retrieval ------------------------------------------------
TOOLFORGE_EMBEDDER=hashing           # hashing (offline, default) | gemini | openai | ollama
# TOOLFORGE_EMBED_MODEL=

# --- behaviour ---------------------------------------------------------------
TOOLFORGE_DB=toolforge.db
TOOLFORGE_DIFFERENTIAL=true
TOOLFORGE_FUZZ_CASES=40
TOOLFORGE_MAX_REPAIRS=3
TOOLFORGE_SANDBOX_TIMEOUT=5
TOOLFORGE_SANDBOX_MEMORY_MB=256
